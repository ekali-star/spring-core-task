<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} [%X{transactionId}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="TRANSACTION_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/transaction.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/transaction.%d{yyyy-MM-dd}.log</fileNamePattern>
        </rollingPolicy>
        <encoder>
            <pattern>%d{ISO8601} TXN=[%X{transactionId}] %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="OPERATION_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/operation.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/operation.%d{yyyy-MM-dd}.log</fileNamePattern>
        </rollingPolicy>
        <encoder>
            <pattern>%d{ISO8601} TXN=[%X{transactionId}] %-5level %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Only endpoint entry/exit events -->
    <logger name="TRANSACTION_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="TRANSACTION_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Everything else -->
    <root level="INFO">
        <appender-ref ref="OPERATION_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>